{{- $pages := .Pages -}}
{{- if .IsHome -}}{{- $pages = where .Site.RegularPages "Section" "post" -}}{{- end -}}
<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom"><channel>
<title>{{ .Title }} | Malu Blog</title><link>{{ .Permalink }}</link><description>Malu 的个人博客：技术笔记、旅行记录和生活随笔。</description><language>zh-CN</language>
<atom:link href="{{ .Permalink }}index.xml" rel="self" type="application/rss+xml"/>
{{ range $pages.ByDate.Reverse }}<item><title>{{ .Title }}</title><link>{{ .Permalink }}</link><guid>{{ .Permalink }}</guid><pubDate>{{ .Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" }}</pubDate><description>{{ .Content | htmlEscape | safeHTML }}</description></item>{{ end }}
</channel></rss>
